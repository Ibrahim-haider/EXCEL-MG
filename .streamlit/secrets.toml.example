# Copy to .streamlit/secrets.toml for local dev, or paste into the
# "Secrets" box in Streamlit Community Cloud's app settings.

# Optional: enables real AI insights via Claude instead of the
# keyword-matching fallback.
ANTHROPIC_API_KEY = ""

# Optional: point at a persistent Postgres DB instead of the bundled
# SQLite file (recommended for anything beyond a demo, since Streamlit
# Cloud's filesystem is wiped on redeploy/reboot).
# DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/dbname"
